# Dockerfile.prebuilt — minimal runtime image for vLLM via package install
# No source build pipeline. Focused on pip-installing a release wheel and
# preserving FlashInfer-backed serving prerequisites.

# =============================================================================
# VERSION ARGS
# =============================================================================
ARG CUDA_VERSION=13.0.0
ARG PYTHON_VERSION=3.12

# Runtime-oriented CUDA base (matches upstream FINAL_BASE_IMAGE pattern)
FROM nvidia/cuda:${CUDA_VERSION}-base-ubuntu22.04

# Re-declare ARGs after FROM so they are available in this stage
ARG CUDA_VERSION=13.0.0
ARG PYTHON_VERSION=3.12
ARG GET_PIP_URL="https://bootstrap.pypa.io/get-pip.py"
ARG PYTORCH_CUDA_INDEX_BASE_URL=https://download.pytorch.org/whl
ARG FLASHINFER_VERSION=0.6.4

ENV DEBIAN_FRONTEND=noninteractive

# Deterministic index resolution for uv
# unsafe-best-match is required so that packages available on both PyPI and
# the PyTorch CUDA index resolve to the newest compatible version across all
# indexes (e.g. setuptools>=77 is only on PyPI, not on the torch index).
ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_HTTP_TIMEOUT=500
ENV UV_LINK_MODE=copy

WORKDIR /vllm-workspace

# =============================================================================
# 1. SYSTEM PACKAGES: Python, pip, host compiler, CUDA JIT toolchain
# =============================================================================

# Install system deps + CUDA JIT toolchain packages
# Derive CUDA_VERSION_DASH once for apt package names (e.g. 13-0)
RUN CUDA_VERSION_DASH=$(echo ${CUDA_VERSION} | cut -d. -f1,2 | tr '.' '-') && \
    apt-get update -y && \
    apt-get install -y --no-install-recommends \
        software-properties-common \
        curl \
        sudo \
        # Host C/C++ compiler — required by torch._inductor / Triton runtime JIT
        gcc \
        g++ \
        # CUDA JIT toolchain — required for FlashInfer / DeepGEMM fallback JIT paths
        cuda-nvcc-${CUDA_VERSION_DASH} \
        cuda-cudart-${CUDA_VERSION_DASH} \
        cuda-nvrtc-${CUDA_VERSION_DASH} \
        cuda-cuobjdump-${CUDA_VERSION_DASH} \
        libcurand-dev-${CUDA_VERSION_DASH} \
        libcublas-${CUDA_VERSION_DASH} \
        # nccl.h needed by pynccl_allocator at runtime
        libnccl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python from deadsnakes PPA
RUN add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update -y && \
    apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-dev \
        python${PYTHON_VERSION}-venv \
    && rm -rf /var/lib/apt/lists/* && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 && \
    update-alternatives --set python3 /usr/bin/python${PYTHON_VERSION} && \
    ln -sf /usr/bin/python${PYTHON_VERSION}-config /usr/bin/python3-config && \
    curl -sS ${GET_PIP_URL} | python${PYTHON_VERSION} && \
    python3 --version && python3 -m pip --version

# Set host compiler path explicitly
ENV CC=/usr/bin/gcc

# Install uv for fast package management
RUN python3 -m pip install --no-cache-dir uv

# =============================================================================
# 2. PYTORCH (from CUDA-specific wheel index)
# =============================================================================
RUN --mount=type=cache,target=/root/.cache/uv \
    CUDA_VERSION_SHORT=cu$(echo ${CUDA_VERSION} | cut -d. -f1,2 | tr -d '.') && \
    uv pip install --system torch torchvision torchaudio \
        --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/${CUDA_VERSION_SHORT}

# vLLM 0.17.1 _C extension was compiled against CUDA 12 and requires the real
# libcudart.so.12 (not a symlink to v13 — SONAME versioning differs).
# Install CUDA 12 runtime pip packages to provide the compat library.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system nvidia-cuda-runtime-cu12

# =============================================================================
# 3. vLLM (release wheel)
# =============================================================================
RUN --mount=type=cache,target=/root/.cache/uv \
    CUDA_VERSION_SHORT=cu$(echo ${CUDA_VERSION} | cut -d. -f1,2 | tr -d '.') && \
    uv pip install --system vllm==0.17.1 \
        --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/${CUDA_VERSION_SHORT}

# =============================================================================
# 4. FLASHINFER RUNTIME ASSETS
# =============================================================================
RUN --mount=type=cache,target=/root/.cache/uv \
    CUDA_VERSION_SHORT=cu$(echo ${CUDA_VERSION} | cut -d. -f1,2 | tr -d '.') && \
    uv pip install --system flashinfer-cubin==${FLASHINFER_VERSION} && \
    uv pip install --system flashinfer-jit-cache==${FLASHINFER_VERSION} \
        --extra-index-url https://flashinfer.ai/whl/${CUDA_VERSION_SHORT}

# =============================================================================
# 5. RUNTIME ENVIRONMENT
# =============================================================================

# Ensure torch shared libs and nvidia pip package libs are on the linker path
# so vllm._C can load libtorch*.so, libcudart, libnccl, etc.
RUN TORCH_LIB=$(python3 -c "import torch; print(torch.__path__[0] + '/lib')") && \
    echo "${TORCH_LIB}" > /etc/ld.so.conf.d/torch.conf && \
    # Add all nvidia pip package lib dirs to linker path
    find /usr/local/lib/python3.12/dist-packages/nvidia -type d -name lib 2>/dev/null \
        >> /etc/ld.so.conf.d/torch.conf && \
    ldconfig

# Ensure the CUDA 12 runtime lib from the pip package is found by the linker.
# Also register all nvidia pip package lib dirs for completeness.
RUN find /usr/local/lib/python3.12/dist-packages/nvidia -type d -name lib 2>/dev/null \
        >> /etc/ld.so.conf.d/torch.conf && \
    ldconfig && \
    ldconfig -p | grep "libcudart.so.12" && \
    echo "libcudart.so.12 available via ldconfig"

# CUDA lib path (include compat/ for libcuda.so.1 stub when no host driver is mounted)
ENV LD_LIBRARY_PATH=/usr/local/cuda/compat:/usr/local/cuda/lib64:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}

# Forward compat flag (off by default, enable via -e at runtime)
ENV VLLM_ENABLE_CUDA_COMPATIBILITY=0

# =============================================================================
# 6. DEFAULT CMD
# =============================================================================
CMD ["python3", "-c", "import vllm; print('vllm', vllm.__version__)"]
